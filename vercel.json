{
  "functions": {
    "api/brain.js": { "maxDuration": 60 },
    "api/whop.js": { "maxDuration": 30 }
  },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "same-origin" },
      { "key": "Permissions-Policy", "value": "microphone=(self)" }
    ] }
  ]
}
